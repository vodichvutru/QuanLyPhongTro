{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=127.0.0.1;Port=3306;Database=quanlyphongtro;User=root;Password=<DB_PASSWORD>;"
  },
  "Jwt": {
    "Secret": "<CHANGE_ME_JWT_SECRET>",
    "Issuer": "QuanLyPhongTro",
    "Audience": "QuanLyPhongTroClient",
    "AccessTokenExpiryMinutes": 1440,
    "RefreshTokenExpiryDays": 7
  }
}
